<!DOCTYPE html>

<html lang="en"><head>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1.0" name="viewport"/>
<title>MedTrack - Adherence Report</title>
<!-- Tailwind CSS CDN v3 with plugins -->
<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            brand: {
              red: '#B91C1C',
              lightRed: '#FEE2E2',
              softPink: '#FCE7F3',
              green: '#047857',
              darkGreen: '#065F46',
              amber: '#B45309',
              orange: '#D97706',
              slateBg: '#F8FAFC'
            }
          },
          fontFamily: {
            sans: ['Inter', 'system-ui', '-apple-system', 'BlinkMacSystemFont', 'Segoe UI', 'Roboto', 'sans-serif'],
          }
        }
      }
    }
  </script>
<style data-purpose="custom-styling">
    body {
      background-color: #F8FAFC;
      color: #0F172A;
      font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    }
  </style>
</head>
<body class="bg-[#F8FAFC] min-h-screen text-slate-800 antialiased selection:bg-rose-100 selection:text-rose-900">
<!-- BEGIN: MainHeader -->
<header class="bg-white border-b border-slate-100 sticky top-0 z-50">
<div class="max-w-6xl mx-auto px-6 h-16 flex items-center justify-between">
<!-- Brand Logo & Name -->
<div class="flex items-center space-x-2">
<div class="w-8 h-8 rounded-lg bg-[#b91c1c] flex items-center justify-center text-white shadow-sm">
<!-- Capsule/Pill Icon -->
<svg class="w-4 h-4 transform -rotate-45" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" viewbox="0 0 24 24">
<rect height="8" rx="4" width="18" x="3" y="8"></rect>
<line x1="12" x2="12" y1="8" y2="16"></line>
</svg>
</div>
<span class="font-bold text-lg tracking-tight text-[#b91c1c]">MedTrack</span>
</div>
<!-- Navigation Links -->
<nav class="hidden md:flex items-center space-x-8 text-sm font-medium text-slate-600">
<a class="hover:text-slate-900 transition-colors" href="#">Today</a>
<a class="hover:text-slate-900 transition-colors" href="#">Medicines</a>
<a class="hover:text-slate-900 transition-colors" href="#">History</a>
<a class="px-4 py-1.5 rounded-full bg-[#FCE8E8] text-[#b91c1c] font-semibold text-xs" href="#">Reports</a>
</nav>
<!-- User Profile Avatar -->
<div class="flex items-center">
<div class="w-8 h-8 rounded-full bg-[#fce7e7] text-[#991b1b] flex items-center justify-center text-xs font-semibold">
          JD
        </div>
</div>
</div>
</header>
<!-- END: MainHeader -->
<!-- BEGIN: MainContent -->
<main class="max-w-4xl mx-auto px-4 py-8">
<!-- Title and Period Toggle -->
<div class="flex items-start justify-between mb-8">
<div>
<h1 class="text-2xl font-bold tracking-tight text-[#0F172A]">Adherence report</h1>
<p class="text-xs font-normal text-slate-400 mt-1">October 2026</p>
</div>
<!-- Segmented Control Button (Weekly / Monthly) -->
<div class="flex items-center bg-[#ECEFF2] p-1 rounded-lg text-xs font-medium text-slate-600">
<button class="px-3.5 py-1 rounded-md text-slate-500 hover:text-slate-800 transition" type="button">Weekly</button>
<button class="px-3.5 py-1 bg-white text-slate-800 font-semibold rounded-md shadow-sm" type="button">Monthly</button>
</div>
</div>
<!-- BEGIN: MetricCardsGrid -->
<section class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
<!-- Card 1: Adherence -->
<div class="bg-white rounded-xl border border-slate-100 p-5 shadow-[0_1px_3px_rgba(0,0,0,0.02)]">
<span class="text-[10px] tracking-wider font-semibold text-slate-400 uppercase">ADHERENCE</span>
<div class="text-3xl font-bold text-[#065F46] mt-1">85%</div>
</div>
<!-- Card 2: Taken -->
<div class="bg-white rounded-xl border border-slate-100 p-5 shadow-[0_1px_3px_rgba(0,0,0,0.02)]">
<span class="text-[10px] tracking-wider font-semibold text-slate-400 uppercase">TAKEN</span>
<div class="text-3xl font-bold text-[#0F172A] mt-1">74</div>
</div>
<!-- Card 3: Missed -->
<div class="bg-white rounded-xl border border-slate-100 p-5 shadow-[0_1px_3px_rgba(0,0,0,0.02)]">
<span class="text-[10px] tracking-wider font-semibold text-slate-400 uppercase">MISSED</span>
<div class="text-3xl font-bold text-[#B91C1C] mt-1">9</div>
</div>
<!-- Card 4: Skipped -->
<div class="bg-white rounded-xl border border-slate-100 p-5 shadow-[0_1px_3px_rgba(0,0,0,0.02)]">
<span class="text-[10px] tracking-wider font-semibold text-slate-400 uppercase">SKIPPED</span>
<div class="text-3xl font-bold text-[#9A3412] mt-1">4</div>
</div>
</section>
<!-- END: MetricCardsGrid -->
<!-- BEGIN: WeeklyAdherenceChart -->
<section class="bg-white rounded-xl border border-slate-100 p-6 shadow-[0_1px_3px_rgba(0,0,0,0.02)] mb-6">
<h2 class="text-sm font-bold text-slate-800 mb-8">Weekly adherence</h2>
<!-- Bar Chart Container -->
<div class="flex justify-center items-end space-x-8 sm:space-x-12 pt-2 pb-1">
<!-- Week 1: 90% -->
<div class="flex flex-col items-center">
<span class="text-xs font-semibold text-slate-700 mb-2">90%</span>
<div class="w-14 sm:w-16 h-40 bg-[#F1F5F9] rounded-xl overflow-hidden flex flex-col justify-end p-0">
<div class="w-full bg-[#065F46] rounded-xl" style="height: 90%;"></div>
</div>
<span class="text-xs text-slate-400 font-medium mt-3">Week 1</span>
</div>
<!-- Week 2: 88% -->
<div class="flex flex-col items-center">
<span class="text-xs font-semibold text-slate-700 mb-2">88%</span>
<div class="w-14 sm:w-16 h-40 bg-[#F1F5F9] rounded-xl overflow-hidden flex flex-col justify-end p-0">
<div class="w-full bg-[#065F46] rounded-xl" style="height: 88%;"></div>
</div>
<span class="text-xs text-slate-400 font-medium mt-3">Week 2</span>
</div>
<!-- Week 3: 80% -->
<div class="flex flex-col items-center">
<span class="text-xs font-semibold text-slate-700 mb-2">80%</span>
<div class="w-14 sm:w-16 h-40 bg-[#F1F5F9] rounded-xl overflow-hidden flex flex-col justify-end p-0">
<div class="w-full bg-[#065F46] rounded-xl" style="height: 80%;"></div>
</div>
<span class="text-xs text-slate-400 font-medium mt-3">Week 3</span>
</div>
<!-- Week 4: 82% -->
<div class="flex flex-col items-center">
<span class="text-xs font-semibold text-slate-700 mb-2">82%</span>
<div class="w-14 sm:w-16 h-40 bg-[#F1F5F9] rounded-xl overflow-hidden flex flex-col justify-end p-0">
<div class="w-full bg-[#065F46] rounded-xl" style="height: 82%;"></div>
</div>
<span class="text-xs text-slate-400 font-medium mt-3">Week 4</span>
</div>
</div>
</section>
<!-- END: WeeklyAdherenceChart -->
<!-- BEGIN: ByMedicineSection -->
<section class="bg-white rounded-xl border border-slate-100 p-6 shadow-[0_1px_3px_rgba(0,0,0,0.02)]">
<h2 class="text-sm font-bold text-slate-800 mb-6">By medicine</h2>
<div class="space-y-5">
<!-- Item 1: Paracetamol 500mg -->
<div class="flex items-center text-xs font-medium">
<span class="w-40 text-slate-700 font-medium shrink-0">Paracetamol 500mg</span>
<div class="flex-1 mx-4 bg-[#F1F5F9] rounded-full h-2">
<div class="bg-[#065F46] h-2 rounded-full" style="width: 96%;"></div>
</div>
<span class="w-8 text-right font-semibold text-slate-700">96%</span>
</div>
<!-- Item 2: Amoxicillin 250mg -->
<div class="flex items-center text-xs font-medium">
<span class="w-40 text-slate-700 font-medium shrink-0">Amoxicillin 250mg</span>
<div class="flex-1 mx-4 bg-[#F1F5F9] rounded-full h-2">
<div class="bg-[#065F46] h-2 rounded-full" style="width: 81%;"></div>
</div>
<span class="w-8 text-right font-semibold text-slate-700">81%</span>
</div>
<!-- Item 3: Cough Syrup 10ml -->
<div class="flex items-center text-xs font-medium">
<span class="w-40 text-slate-700 font-medium shrink-0">Cough Syrup 10ml</span>
<div class="flex-1 mx-4 bg-[#F1F5F9] rounded-full h-2">
<div class="bg-[#C25E00] h-2 rounded-full" style="width: 70%;"></div>
</div>
<span class="w-8 text-right font-semibold text-slate-700">70%</span>
</div>
<!-- Item 4: Vitamin C 500mg -->
<div class="flex items-center text-xs font-medium">
<span class="w-40 text-slate-700 font-medium shrink-0">Vitamin C 500mg</span>
<div class="flex-1 mx-4 bg-[#F1F5F9] rounded-full h-2">
<div class="bg-[#C25E00] h-2 rounded-full" style="width: 78%;"></div>
</div>
<span class="w-8 text-right font-semibold text-slate-700">78%</span>
</div>
</div>
</section>
<!-- END: ByMedicineSection -->
</main>
<!-- END: MainContent -->
</body></html>