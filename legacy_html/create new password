<!DOCTYPE html>

<html lang="en"><head>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1.0" name="viewport"/>
<title>MedTrack - Create New Password</title>
<!-- Load Tailwind CSS v3 with forms and container queries plugins -->
<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            brand: {
              50: '#fff1f2',
              100: '#ffe4e6',
              500: '#f43f5e',
              600: '#e11d48',
              700: '#be123c',
            }
          }
        }
      }
    }
  </script>
<style data-purpose="custom-styling">
    body {
      background-color: #f4f7fa;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    }
  </style>
</head>
<body class="min-h-screen flex flex-col items-center justify-center p-4 sm:p-6 lg:p-8 text-slate-700">
<!-- BEGIN: MainContent -->
<main class="w-full max-w-[540px] flex flex-col items-center">
<!-- BEGIN: ResetPasswordCard -->
<section class="w-full bg-white rounded-3xl shadow-[0_10px_35px_-4px_rgba(0,0,0,0.06),0_4px_12px_-2px_rgba(0,0,0,0.03)] border border-slate-100 p-8 sm:p-10 flex flex-col items-center" data-purpose="password-reset-card">
<!-- BEGIN: HeaderSection -->
<!-- Top icon badge -->
<div class="relative mb-3 flex items-center justify-center">
<div class="w-14 h-14 bg-gradient-to-b from-rose-500 to-rose-600 rounded-2xl flex items-center justify-center shadow-md shadow-rose-200">
<svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" stroke-width="2.2" viewbox="0 0 24 24">
<path d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" stroke-linecap="round" stroke-linejoin="round"></path>
</svg>
</div>
<!-- Status indicator dot -->
<span class="absolute -bottom-1 -right-1 w-5 h-5 bg-emerald-500 rounded-full border-2 border-white flex items-center justify-center text-white">
<svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="3" viewbox="0 0 24 24">
<path d="M5 13l4 4L19 7" stroke-linecap="round" stroke-linejoin="round"></path>
</svg>
</span>
</div>
<!-- Security Protocol Tag -->
<div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-rose-50 text-[11px] font-bold text-rose-600 tracking-wider uppercase mb-3">
<span class="w-1.5 h-1.5 rounded-full bg-rose-500"></span>
        SECURITY PROTOCOL
      </div>
<!-- Title & Description -->
<h1 class="text-[26px] font-bold text-slate-900 tracking-tight text-center mb-2">Create new password</h1>
<p class="text-sm text-slate-500 text-center max-w-[420px] leading-relaxed mb-4">
        Set a strong, HIPAA-compliant password to restore access to your medication schedule and dose alerts.
      </p>
<!-- Account Email Badge -->
<div class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-slate-50 border border-slate-200 text-xs text-slate-600 mb-6">
<svg class="w-3.5 h-3.5 text-rose-500" fill="none" stroke="currentColor" stroke-width="2" viewbox="0 0 24 24">
<path d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" stroke-linecap="round" stroke-linejoin="round"></path>
</svg>
<span>Resetting for: <strong class="text-slate-800 font-semibold">alex.johnson@example.com</strong></span>
</div>
<!-- END: HeaderSection -->
<!-- BEGIN: PasswordForm -->
<form class="w-full space-y-5" onsubmit="event.preventDefault();">
<!-- Field 1: New Password -->
<div>
<div class="flex items-center justify-between text-xs font-semibold mb-1.5">
<label class="text-slate-700" for="new-password">New Password</label>
<span class="text-rose-500 tracking-wide text-[11px] font-bold">REQUIRED</span>
</div>
<div class="relative">
<span class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
<svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewbox="0 0 24 24">
<rect height="11" rx="2" stroke-linecap="round" stroke-linejoin="round" width="16" x="4" y="10"></rect>
<path d="M8 10V7a4 4 0 118 0v3" stroke-linecap="round" stroke-linejoin="round"></path>
</svg>
</span>
<input class="w-full pl-10 pr-10 py-2.5 text-sm bg-slate-50 border border-slate-200 rounded-xl text-slate-800 font-medium focus:ring-2 focus:ring-rose-500/20 focus:border-rose-500 transition-all outline-none" id="new-password" type="text" value="MedTrack2025!Shield"/>
<button class="absolute inset-y-0 right-0 pr-3.5 flex items-center text-slate-400 hover:text-slate-600" type="button">
<svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewbox="0 0 24 24">
<path d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" stroke-linecap="round" stroke-linejoin="round"></path>
<path d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" stroke-linecap="round" stroke-linejoin="round"></path>
</svg>
</button>
</div>
<!-- Password Strength Indicator -->
<div class="flex items-center justify-between text-xs mt-2 px-0.5">
<span class="text-slate-500">Password Strength</span>
<span class="font-bold text-slate-800">Strong</span>
</div>
<!-- Criteria Checklist Box -->
<div class="mt-2.5 p-3.5 bg-slate-50/80 rounded-xl border border-slate-100 text-xs space-y-1.5 text-slate-600">
<div class="flex items-center gap-2">
<svg class="w-4 h-4 text-emerald-600 shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewbox="0 0 24 24">
<path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" stroke-linecap="round" stroke-linejoin="round"></path>
</svg>
<span>At least 8 characters</span>
</div>
<div class="flex items-center gap-2">
<svg class="w-4 h-4 text-emerald-600 shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewbox="0 0 24 24">
<path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" stroke-linecap="round" stroke-linejoin="round"></path>
</svg>
<span>Includes uppercase &amp; lowercase letters</span>
</div>
<div class="flex items-center gap-2">
<svg class="w-4 h-4 text-emerald-600 shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewbox="0 0 24 24">
<path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" stroke-linecap="round" stroke-linejoin="round"></path>
</svg>
<span>Includes at least one number or special symbol</span>
</div>
<div class="flex items-center gap-2">
<svg class="w-4 h-4 text-emerald-600 shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewbox="0 0 24 24">
<path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" stroke-linecap="round" stroke-linejoin="round"></path>
</svg>
<span>Does not match previously recorded passwords</span>
</div>
</div>
</div>
<!-- Field 2: Confirm Password -->
<div>
<div class="flex items-center justify-between text-xs font-semibold mb-1.5">
<label class="text-slate-700" for="confirm-password">Confirm New Password</label>
<span class="text-emerald-700 font-bold flex items-center gap-1 text-[11px]">
<svg class="w-3.5 h-3.5 text-emerald-600" fill="none" stroke="currentColor" stroke-width="2.5" viewbox="0 0 24 24">
<path d="M5 13l4 4L19 7" stroke-linecap="round" stroke-linejoin="round"></path>
</svg>
              PASSWORDS MATCH
            </span>
</div>
<div class="relative">
<span class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
<svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewbox="0 0 24 24">
<rect height="11" rx="2" stroke-linecap="round" stroke-linejoin="round" width="16" x="4" y="10"></rect>
<path d="M8 10V7a4 4 0 118 0v3" stroke-linecap="round" stroke-linejoin="round"></path>
</svg>
</span>
<input class="w-full pl-10 pr-10 py-2.5 text-sm bg-slate-50 border border-slate-200 rounded-xl text-slate-800 font-medium focus:ring-2 focus:ring-rose-500/20 focus:border-rose-500 transition-all outline-none" id="confirm-password" type="text" value="MedTrack2025!Shield"/>
<button class="absolute inset-y-0 right-0 pr-3.5 flex items-center text-slate-400 hover:text-slate-600" type="button">
<svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewbox="0 0 24 24">
<path d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" stroke-linecap="round" stroke-linejoin="round"></path>
<path d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" stroke-linecap="round" stroke-linejoin="round"></path>
</svg>
</button>
</div>
</div>
<!-- Checkbox: Sign out other devices -->
<div class="p-3.5 bg-slate-50/70 border border-slate-200/80 rounded-xl flex items-start gap-3">
<input checked="" class="mt-0.5 w-4 h-4 text-rose-600 rounded border-slate-300 focus:ring-rose-500 cursor-pointer" id="signout-devices" type="checkbox"/>
<div class="text-xs leading-normal">
<label class="font-bold text-slate-800 cursor-pointer block" for="signout-devices">
              Sign out of all other devices &amp; browsers
            </label>
<p class="text-slate-500 mt-0.5">
              Recommended: Safeguards adherence schedules and prescription alerts from unauthorized devices.
            </p>
</div>
</div>
<!-- Action Buttons -->
<div class="space-y-2.5 pt-1">
<!-- Primary Submit Button -->
<button class="w-full py-3 px-4 bg-gradient-to-r from-rose-600 to-rose-600 hover:from-rose-700 hover:to-rose-700 text-white font-semibold text-sm rounded-xl shadow-md shadow-rose-600/20 flex items-center justify-center gap-2 transition duration-150 cursor-pointer" type="submit">
<span>Reset Password &amp; Log In</span>
<svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewbox="0 0 24 24">
<path d="M14 5l7 7m0 0l-7 7m7-7H3" stroke-linecap="round" stroke-linejoin="round"></path>
</svg>
</button>
<!-- Cancel Button -->
<a class="w-full py-2.5 px-4 bg-slate-100 hover:bg-slate-200 text-slate-700 font-semibold text-xs rounded-xl flex items-center justify-center gap-1.5 transition duration-150" href="#">
<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewbox="0 0 24 24">
<path d="M10 19l-7-7m0 0l7-7m-7 7h18" stroke-linecap="round" stroke-linejoin="round"></path>
</svg>
<span>Cancel and return to Log in</span>
</a>
</div>
</form>
<!-- END: PasswordForm -->
<!-- Security Subtext & Support Link -->
<div class="mt-6 text-center space-y-1.5">
<div class="inline-flex items-center gap-1 text-[11px] text-slate-500 font-medium">
<svg class="w-3.5 h-3.5 text-rose-500 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewbox="0 0 24 24">
<path d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" stroke-linecap="round" stroke-linejoin="round"></path>
</svg>
<span>256-Bit Encrypted &amp; HIPAA-Compliant Healthcare Storage</span>
</div>
<p class="text-xs text-slate-500">
          Having trouble? <a class="font-semibold text-rose-600 hover:text-rose-700 hover:underline" href="#">Contact Caregiver or Support</a>
</p>
</div>
</section>
<!-- END: ResetPasswordCard -->
<!-- BEGIN: Footer -->
<footer class="mt-6 flex flex-col items-center gap-2">
<div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white/80 border border-slate-200/80 text-[11px] text-slate-600 shadow-sm backdrop-blur-sm">
<div class="flex items-center gap-1 text-slate-600 font-medium">
<svg class="w-3 h-3 text-rose-500" fill="none" stroke="currentColor" stroke-width="2" viewbox="0 0 24 24">
<rect height="11" rx="2" stroke-linecap="round" stroke-linejoin="round" width="16" x="4" y="10"></rect>
<path d="M8 10V7a4 4 0 118 0v3" stroke-linecap="round" stroke-linejoin="round"></path>
</svg>
<span>End-to-End Encrypted Medication Profile</span>
</div>
<span class="text-slate-300">•</span>
<a class="hover:text-slate-900 transition-colors" href="#">Privacy Policy</a>
<span class="text-slate-300">•</span>
<a class="hover:text-slate-900 transition-colors" href="#">Terms of Care</a>
</div>
<div class="text-[11px] text-slate-400">
        © 2025 MedTrack Healthcare Systems, Inc. All rights reserved.
      </div>
</footer>
<!-- END: Footer -->
</main>
<!-- END: MainContent -->
</body></html>