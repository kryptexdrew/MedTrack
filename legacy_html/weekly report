<!DOCTYPE html><html lang="en"><head>
<meta charset="utf-8">
<meta content="width=device-width, initial-scale=1.0" name="viewport">
<title>MedTrack - Reports Weekly</title>
<!-- Tailwind CSS CDN v3 with plugins -->
<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<!-- Tailwind Custom Configuration -->
<script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            brand: {
              red: '#c91f28',
              'red-active': '#df2333',
              'active-pill': '#fdecee',
              dark: '#1e2432',
              green: '#047835',
              amber: '#d96504',
              crimson: '#b91c1c',
              'chart-bg': '#f0f4f8'
            }
          },
          fontFamily: {
            sans: ['Inter', 'system-ui', '-apple-system', 'BlinkMacSystemFont', 'Segoe UI', 'Roboto', 'sans-serif'],
          }
        }
      }
    }
  </script>
<style data-purpose="base-styling">
    body {
      background-color: #1e1e1e;
      margin: 0;
      padding: 0;
      font-family: 'Inter', system-ui, -apple-system, sans-serif;
      -webkit-font-smoothing: antialiased;
    }
    /* Subtle rounded cards */
    .card-border {
      border: 1px solid #f1f3f6;
    }
  </style>
</head>
<body class="min-h-screen flex flex-col bg-[#f8f9fa]">
<!-- Subtitle note preview indicator from frame -->

<!-- BEGIN: MainContainer -->
<div class="w-full flex-1 flex flex-col" data-purpose="app-window">
<!-- BEGIN: Header -->
<header class="w-full bg-white border-b border-gray-100 px-8 py-3.5 flex items-center justify-between" data-purpose="top-navigation">
<!-- Logo Branding -->
<div class="flex items-center space-x-2.5">
<div class="w-7 h-7 bg-[#c91f28] rounded-md flex items-center justify-center transform -rotate-45 shadow-sm">
<div class="w-3.5 h-[2px] bg-white rounded-full"></div>
</div>
<span class="text-lg font-bold tracking-tight text-[#c91f28]">MedTrack</span>
</div>
<!-- Navigation Links -->
<nav class="hidden sm:flex items-center space-x-1.5 text-xs font-semibold text-gray-600">
<a class="px-4 py-1.5 rounded-full hover:text-gray-900 transition-colors" href="#">Today</a>
<a class="px-4 py-1.5 rounded-full hover:text-gray-900 transition-colors" href="#">Medicines</a>
<a class="px-4 py-1.5 rounded-full hover:text-gray-900 transition-colors" href="#">History</a>
<a class="px-4 py-1.5 rounded-full bg-[#fdecef] text-[#b91c1c] transition-colors" href="#">Reports</a>
</nav>
<!-- User Avatar -->
<div class="flex items-center">
<div class="w-8 h-8 rounded-full bg-[#fae8ea] flex items-center justify-center text-[#c91f28] font-bold text-[11px] border border-[#f5d0d6]">
          JD
        </div>
</div>
</header>
<!-- END: Header -->
<!-- BEGIN: MainContent -->
<main class="w-full max-w-[1020px] mx-auto flex-1 p-6 md:p-10 space-y-6">
<!-- Header Title and Range Controls -->
<div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
<div>
<h1 class="text-[22px] font-bold text-gray-900 leading-snug">Adherence report</h1>
<p class="text-xs text-gray-400 mt-0.5 font-normal">Oct 11 – Oct 17, 2026</p>
</div>
<!-- Weekly / Monthly Toggle -->
<div class="inline-flex items-center bg-[#eaedf1] p-1 rounded-xl self-start sm:self-auto text-xs font-medium text-gray-500">
<button class="bg-white text-gray-800 shadow-sm rounded-lg px-4 py-1 font-medium transition-all">Weekly</button>
<button class="px-4 py-1 rounded-lg text-gray-500 hover:text-gray-800 transition-all">Monthly</button>
</div>
</div>
<!-- BEGIN: StatCards -->
<section class="grid grid-cols-2 md:grid-cols-4 gap-4" data-purpose="key-metrics-summary">
<!-- Adherence -->
<div class="bg-white p-4 rounded-xl border border-gray-100 shadow-[0_1px_3px_rgba(0,0,0,0.02)]">
<span class="block text-[10px] font-bold tracking-wider text-gray-400 uppercase">Adherence</span>
<span class="block text-2xl font-bold text-[#047835] mt-1.5 leading-none">86%</span>
</div>
<!-- Taken -->
<div class="bg-white p-4 rounded-xl border border-gray-100 shadow-[0_1px_3px_rgba(0,0,0,0.02)]">
<span class="block text-[10px] font-bold tracking-wider text-gray-400 uppercase">Taken</span>
<span class="block text-2xl font-bold text-gray-900 mt-1.5 leading-none">18</span>
</div>
<!-- Missed -->
<div class="bg-white p-4 rounded-xl border border-gray-100 shadow-[0_1px_3px_rgba(0,0,0,0.02)]">
<span class="block text-[10px] font-bold tracking-wider text-gray-400 uppercase">Missed</span>
<span class="block text-2xl font-bold text-[#b91c1c] mt-1.5 leading-none">2</span>
</div>
<!-- Skipped -->
<div class="bg-white p-4 rounded-xl border border-gray-100 shadow-[0_1px_3px_rgba(0,0,0,0.02)]">
<span class="block text-[10px] font-bold tracking-wider text-gray-400 uppercase">Skipped</span>
<span class="block text-2xl font-bold text-[#b45309] mt-1.5 leading-none">1</span>
</div>
</section>
<!-- END: StatCards -->
<!-- BEGIN: DailyAdherenceChart -->
<section class="bg-white rounded-xl border border-gray-100 shadow-[0_1px_3px_rgba(0,0,0,0.02)] p-6" data-purpose="daily-adherence-chart">
<h2 class="text-sm font-bold text-gray-800 mb-6">Daily adherence</h2>
<!-- Bar Graph Area -->
<div class="flex items-end justify-center space-x-4 sm:space-x-7 pt-4 pb-2">
<!-- Sun (100%) -->
<div class="flex flex-col items-center">
<span class="text-[10px] font-semibold text-gray-700 mb-2">100%</span>
<div class="w-9 sm:w-10 h-36 bg-[#f0f3f6] rounded-md relative flex items-end overflow-hidden">
<div class="w-full h-full bg-[#047835] rounded-md"></div>
</div>
<span class="text-[10px] text-gray-400 font-medium mt-2">Sun</span>
</div>
<!-- Mon (100%) -->
<div class="flex flex-col items-center">
<span class="text-[10px] font-semibold text-gray-700 mb-2">100%</span>
<div class="w-9 sm:w-10 h-36 bg-[#f0f3f6] rounded-md relative flex items-end overflow-hidden">
<div class="w-full h-full bg-[#047835] rounded-md"></div>
</div>
<span class="text-[10px] text-gray-400 font-medium mt-2">Mon</span>
</div>
<!-- Tue (100%) -->
<div class="flex flex-col items-center">
<span class="text-[10px] font-semibold text-gray-700 mb-2">100%</span>
<div class="w-9 sm:w-10 h-36 bg-[#f0f3f6] rounded-md relative flex items-end overflow-hidden">
<div class="w-full h-full bg-[#047835] rounded-md"></div>
</div>
<span class="text-[10px] text-gray-400 font-medium mt-2">Tue</span>
</div>
<!-- Wed (67%) -->
<div class="flex flex-col items-center">
<span class="text-[10px] font-semibold text-gray-700 mb-2">67%</span>
<div class="w-9 sm:w-10 h-36 bg-[#f0f3f6] rounded-md relative flex items-end overflow-hidden">
<div class="w-full h-[67%] bg-[#d96504] rounded-md"></div>
</div>
<span class="text-[10px] text-gray-400 font-medium mt-2">Wed</span>
</div>
<!-- Thu (100%) -->
<div class="flex flex-col items-center">
<span class="text-[10px] font-semibold text-gray-700 mb-2">100%</span>
<div class="w-9 sm:w-10 h-36 bg-[#f0f3f6] rounded-md relative flex items-end overflow-hidden">
<div class="w-full h-full bg-[#047835] rounded-md"></div>
</div>
<span class="text-[10px] text-gray-400 font-medium mt-2">Thu</span>
</div>
<!-- Fri (67%) -->
<div class="flex flex-col items-center">
<span class="text-[10px] font-semibold text-gray-700 mb-2">67%</span>
<div class="w-9 sm:w-10 h-36 bg-[#f0f3f6] rounded-md relative flex items-end overflow-hidden">
<div class="w-full h-[67%] bg-[#d96504] rounded-md"></div>
</div>
<span class="text-[10px] text-gray-400 font-medium mt-2">Fri</span>
</div>
<!-- Sat (33%) -->
<div class="flex flex-col items-center">
<span class="text-[10px] font-semibold text-gray-700 mb-2">33%</span>
<div class="w-9 sm:w-10 h-36 bg-[#f0f3f6] rounded-md relative flex items-end overflow-hidden">
<div class="w-full h-[33%] bg-[#b91c1c] rounded-md"></div>
</div>
<span class="text-[10px] text-gray-400 font-medium mt-2">Sat</span>
</div>
</div>
</section>
<!-- END: DailyAdherenceChart -->
<!-- BEGIN: ByMedicineSection -->
<section class="bg-white rounded-xl border border-gray-100 shadow-[0_1px_3px_rgba(0,0,0,0.02)] p-6" data-purpose="by-medicine-breakdown">
<h2 class="text-sm font-bold text-gray-800 mb-5">By medicine</h2>
<div class="space-y-4">
<!-- Paracetamol 500mg -->
<div class="flex items-center text-xs font-semibold text-gray-700">
<div class="w-40 sm:w-48 shrink-0 truncate">Paracetamol 500mg</div>
<div class="flex-1 mx-3 bg-[#f0f3f6] h-2 rounded-full overflow-hidden">
<div class="bg-[#047835] h-full rounded-full" style="width: 100%;"></div>
</div>
<span class="w-9 text-right text-[11px] font-semibold text-gray-700">100%</span>
</div>
<!-- Amoxicillin 250mg -->
<div class="flex items-center text-xs font-semibold text-gray-700">
<div class="w-40 sm:w-48 shrink-0 truncate">Amoxicillin 250mg</div>
<div class="flex-1 mx-3 bg-[#f0f3f6] h-2 rounded-full overflow-hidden">
<div class="bg-[#d96504] h-full rounded-full" style="width: 78%;"></div>
</div>
<span class="w-9 text-right text-[11px] font-semibold text-gray-700">78%</span>
</div>
<!-- Cough Syrup 10ml -->
<div class="flex items-center text-xs font-semibold text-gray-700">
<div class="w-40 sm:w-48 shrink-0 truncate">Cough Syrup 10ml</div>
<div class="flex-1 mx-3 bg-[#f0f3f6] h-2 rounded-full overflow-hidden">
<div class="bg-[#d96504] h-full rounded-full" style="width: 67%;"></div>
</div>
<span class="w-9 text-right text-[11px] font-semibold text-gray-700">67%</span>
</div>
<!-- Vitamin C 500mg -->
<div class="flex items-center text-xs font-semibold text-gray-700">
<div class="w-40 sm:w-48 shrink-0 truncate">Vitamin C 500mg</div>
<div class="flex-1 mx-3 bg-[#f0f3f6] h-2 rounded-full overflow-hidden">
<div class="bg-[#d96504] h-full rounded-full" style="width: 75%;"></div>
</div>
<span class="w-9 text-right text-[11px] font-semibold text-gray-700">75%</span>
</div>
</div>
</section>
<!-- END: ByMedicineSection -->
</main>
<!-- END: MainContent -->
</div>
<!-- END: MainContainer -->


</body></html>