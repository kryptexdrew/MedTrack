<!DOCTYPE html>

<html lang="en"><head>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1.0" name="viewport"/>
<title>MedTrack - Create your medication profile</title>
<!-- Tailwind CSS v3 CDN -->
<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            brand: {
              50: '#fff1f2',
              100: '#ffe4e6',
              500: '#f43f5e',
              600: '#e11d48',
              700: '#be123c',
              primary: '#DC2626',
              primaryHover: '#B91C1C'
            }
          },
          fontFamily: {
            sans: ['Inter', 'system-ui', '-apple-system', 'BlinkMacSystemFont', 'Segoe UI', 'Roboto', 'sans-serif'],
          }
        }
      }
    }
  </script>
<style data-purpose="custom-layout">
    body {
      background-color: #f7fafc;
      background-image: radial-gradient(circle at 50% 30%, #f0f7f7 0%, #f6f9fa 60%, #edf2f7 100%);
      min-height: 100vh;
    }
  </style>
</head>
<body class="text-slate-700 font-sans antialiased flex flex-col justify-between p-4 sm:p-6 min-h-screen">
<!-- BEGIN: TopStatusIndicator -->
<header class="w-full max-w-7xl mx-auto flex items-center justify-start py-2">
<div class="flex items-center space-x-2 text-xs font-medium text-slate-500" data-purpose="status-badge">
<span class="inline-block w-2 h-2 rounded-full bg-emerald-500 ring-2 ring-emerald-100"></span>
<span>System Operational &amp; HIPAA Compliant</span>
</div>
</header>
<!-- END: TopStatusIndicator -->
<!-- BEGIN: SignUpModalCard -->
<main class="w-full flex-grow flex items-center justify-center my-4 sm:my-6">
<div class="w-full max-w-[490px] bg-white rounded-3xl shadow-[0_20px_50px_rgba(0,0,0,0.06)] border border-slate-100 p-7 sm:p-9 relative" data-purpose="signup-card">
<!-- Top Pill Icon Badge -->
<div class="flex justify-center mb-3">
<div class="w-11 h-11 rounded-2xl bg-rose-50 flex items-center justify-center border border-rose-100/60 shadow-sm" data-purpose="logo-icon-container">
<!-- Capsule Pill SVG -->
<svg class="w-5 h-5 text-red-500 transform -rotate-45" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" viewbox="0 0 24 24">
<rect height="8" rx="4" ry="4" width="18" x="3" y="8"></rect>
<path d="M12 8v8"></path>
</svg>
</div>
</div>
<!-- Header Titles -->
<div class="text-center mb-6">
<h1 class="text-2xl font-bold text-slate-900 tracking-tight">MedTrack</h1>
<p class="text-xs text-slate-500 mt-1 font-medium">Create your medication profile</p>
</div>
<!-- Registration Form -->
<form class="space-y-4" data-purpose="registration-form" onsubmit="event.preventDefault();">
<!-- Role / User Mode Selection -->
<div class="bg-slate-50/70 p-2.5 rounded-2xl border border-slate-100" data-purpose="mode-selector">
<span class="block text-[10px] font-bold uppercase tracking-wider text-slate-400 mb-2 px-1">
            I AM USING MEDTRACK FOR
          </span>
<!-- Active Option: My Own Care (full width) -->
<button class="w-full flex items-center justify-center space-x-2 py-2 px-3 bg-white rounded-xl border border-rose-200/80 shadow-sm text-xs font-semibold text-slate-800 focus:outline-none ring-1 ring-rose-200 transition-colors" type="button">
<svg class="w-3.5 h-3.5 text-rose-500" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" viewbox="0 0 24 24">
<path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"></path>
<circle cx="12" cy="7" r="4"></circle>
</svg>
<span>My Own Care</span>
</button>
</div>
<!-- Full Name Input -->
<div data-purpose="form-group-name">
<div class="flex justify-between items-center text-xs mb-1">
<label class="font-medium text-slate-700" for="fullname">Full Name</label>
<span class="text-[11px] text-slate-400">Legal or Preferred</span>
</div>
<div class="relative rounded-xl border border-slate-200 bg-slate-50/50 hover:bg-white focus-within:bg-white focus-within:border-slate-400 transition-all">
<div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-slate-400">
<!-- Contact Badge Icon -->
<svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" viewbox="0 0 24 24">
<rect height="16" rx="2" width="18" x="3" y="4"></rect>
<circle cx="12" cy="10" r="2.5"></circle>
<path d="M8 17a4 4 0 0 1 8 0"></path>
</svg>
</div>
<input class="w-full pl-9 pr-3 py-2 text-xs text-slate-800 placeholder-slate-400 bg-transparent border-0 focus:ring-0 rounded-xl" id="fullname" placeholder="e.g., Alex Johnson" type="text"/>
</div>
</div>
<!-- Email Address Input -->
<div data-purpose="form-group-email">
<div class="flex justify-between items-center text-xs mb-1">
<label class="font-medium text-slate-700" for="email">Email Address</label>
<span class="text-[11px] text-slate-400">For dose reminders</span>
</div>
<div class="relative rounded-xl border border-slate-200 bg-slate-50/50 hover:bg-white focus-within:bg-white focus-within:border-slate-400 transition-all">
<div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-slate-400">
<!-- Mail Icon -->
<svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" viewbox="0 0 24 24">
<rect height="16" rx="2" width="20" x="2" y="4"></rect>
<path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
</svg>
</div>
<input class="w-full pl-9 pr-3 py-2 text-xs text-slate-800 placeholder-slate-400 bg-transparent border-0 focus:ring-0 rounded-xl" id="email" placeholder="name@email.com" type="email"/>
</div>
</div>
<!-- Two-column Password & Confirm -->
<div class="grid grid-cols-2 gap-3" data-purpose="form-group-passwords">
<!-- Password Field -->
<div>
<div class="flex justify-between items-center text-xs mb-1">
<label class="font-medium text-slate-700" for="password">Password</label>
</div>
<div class="relative rounded-xl border border-slate-200 bg-slate-50/50 hover:bg-white focus-within:bg-white focus-within:border-slate-400 transition-all">
<div class="absolute inset-y-0 left-0 pl-2.5 flex items-center pointer-events-none text-slate-400">
<!-- Lock Icon -->
<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewbox="0 0 24 24">
<rect height="11" rx="2" ry="2" width="18" x="3" y="11"></rect>
<path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
</svg>
</div>
<input class="w-full pl-8 pr-7 py-2 text-xs tracking-widest text-slate-600 bg-transparent border-0 focus:ring-0 rounded-xl" id="password" type="password" value="secret123"/>
<!-- Show/Hide Eye Icon -->
<button class="absolute inset-y-0 right-0 pr-2 flex items-center text-slate-400 hover:text-slate-600" type="button">
<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" viewbox="0 0 24 24">
<path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"></path>
<circle cx="12" cy="12" r="3"></circle>
</svg>
</button>
</div>
</div>
<!-- Confirm Field -->
<div>
<div class="flex justify-between items-center text-xs mb-1">
<label class="font-medium text-slate-700" for="confirm">Confirm</label>
<span class="text-[10px] text-slate-400">Match check</span>
</div>
<div class="relative rounded-xl border border-slate-200 bg-slate-50/50 hover:bg-white focus-within:bg-white focus-within:border-slate-400 transition-all">
<div class="absolute inset-y-0 left-0 pl-2.5 flex items-center pointer-events-none text-slate-400">
<!-- Shield Check Icon -->
<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewbox="0 0 24 24">
<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
<path d="m9 12 2 2 4-4"></path>
</svg>
</div>
<input class="w-full pl-8 pr-3 py-2 text-xs tracking-widest text-slate-600 bg-transparent border-0 focus:ring-0 rounded-xl" id="confirm" type="password" value="secret123"/>
</div>
</div>
</div>
<!-- Password Requirements Bar -->
<div class="flex items-center justify-between text-[11px] bg-slate-50/60 px-3 py-1.5 rounded-lg border border-slate-100" data-purpose="password-strength">
<div class="flex items-center space-x-1.5 text-slate-500">
<span class="inline-block w-1.5 h-1.5 rounded-full bg-rose-500"></span>
<span>At least 8 characters with letters &amp; numbers</span>
</div>
<!-- 3-dot strength meter -->
<div class="flex items-center space-x-1">
<span class="w-2.5 h-1 rounded-full bg-slate-300"></span>
<span class="w-2.5 h-1 rounded-full bg-slate-300"></span>
<span class="w-2.5 h-1 rounded-full bg-slate-300"></span>
</div>
</div>
<!-- Agreement Checkbox -->
<div class="flex items-start space-x-2 pt-1" data-purpose="terms-agreement">
<input class="mt-0.5 w-4 h-4 rounded border-slate-300 text-rose-600 focus:ring-rose-500" id="terms" type="checkbox"/>
<label class="text-[11px] leading-tight text-slate-500 select-none" for="terms">
            I agree to the <a class="text-rose-600 hover:underline font-medium" href="#">Terms of Care</a> and <a class="text-rose-600 hover:underline font-medium" href="#">HIPAA-compliant Privacy Policy</a>.
          </label>
</div>
<!-- Primary Submit Button -->
<div class="pt-2">
<button class="w-full flex items-center justify-center space-x-2 bg-red-600 hover:bg-red-700 text-white font-medium py-2.5 px-4 rounded-xl shadow-md shadow-red-600/20 transition-all duration-150 focus:outline-none focus:ring-2 focus:ring-red-500 focus:ring-offset-2" type="submit">
<span class="text-sm">Create Account</span>
<svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewbox="0 0 24 24">
<path d="M5 12h14"></path>
<path d="m12 5 7 7-7 7"></path>
</svg>
</button>
</div>
<!-- Log In Callout -->
<div class="text-center text-xs text-slate-500 pt-1">
          Already have an account? <a class="text-rose-600 font-semibold hover:underline" href="#">Log in</a>
</div>
<!-- Security Callout Box -->
<div class="mt-4 pt-1" data-purpose="security-guarantee">
<div class="w-full bg-slate-50 border border-slate-200/80 rounded-xl py-2 px-3 flex items-center justify-center space-x-2 text-[10px] tracking-tight font-semibold text-slate-600">
<!-- Shield/Check Icon -->
<svg class="w-3.5 h-3.5 text-rose-500 shrink-0" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewbox="0 0 24 24">
<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
<path d="m9 12 2 2 4-4"></path>
</svg>
<span class="uppercase tracking-wide">256-Bit Encrypted &amp; HIPAA-Compliant Healthcare Storage</span>
</div>
</div>
</form>
</div>
</main>
<!-- END: SignUpModalCard -->
<!-- BEGIN: PageFooter -->
<footer class="w-full max-w-7xl mx-auto flex flex-col items-center justify-center space-y-2 py-3 text-center text-[11px]" data-purpose="page-footer">
<!-- Bottom Pills Badge -->
<div class="inline-flex items-center space-x-2 bg-white/90 backdrop-blur-sm border border-slate-200/70 shadow-sm rounded-full py-1.5 px-4 text-slate-500">
<div class="flex items-center space-x-1.5 text-rose-500 font-medium">
<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewbox="0 0 24 24">
<rect height="11" rx="2" ry="2" width="18" x="3" y="11"></rect>
<path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
</svg>
<span>End-to-End Encrypted Medication Profile</span>
</div>
<span class="text-slate-300">•</span>
<a class="hover:text-slate-800 transition-colors" href="#">Privacy Policy</a>
<span class="text-slate-300">•</span>
<a class="hover:text-slate-800 transition-colors" href="#">Terms of Care</a>
</div>
<!-- Copyright Text -->
<div class="text-[10px] text-slate-400 font-normal">
      © 2025 MedTrack Healthcare Systems, Inc. All rights reserved.
    </div>
</footer>
<!-- END: PageFooter -->
</body></html>