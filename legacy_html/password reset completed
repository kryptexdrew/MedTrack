<!-- Interactive Timer Logic (Optional functional enhancement) -->
<script data-purpose="countdown-controller">
    let secondsLeft = 5;
    let isPaused = false;
    const countdownEl = document.getElementById('countdown-timer');
    const pauseBtn = document.getElementById('pause-redirect-btn');

    const timer = setInterval(() => {
      if (!isPaused && secondsLeft > 0) {
        secondsLeft--;
        countdownEl.textContent = secondsLeft + 's....';
        if (secondsLeft === 0) {
          clearInterval(timer);
          countdownEl.textContent = 'Redirecting...';
        }
      }
    }, 1000);

    pauseBtn.addEventListener('click', () => {
      isPaused = !isPaused;
      pauseBtn.textContent = isPaused ? 'Resume' : 'Pause';
    });
  </script>
