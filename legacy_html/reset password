<!DOCTYPE html>

<html lang="en"><head>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1.0" name="viewport"/>
<title>MedTrack - Reset Password</title>
<!-- Tailwind CSS CDN -->
<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<!-- Tailwind Configuration -->
<script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            brand: {
              red: '#D92D20',
              redHover: '#B42318',
              redLight: '#FEE4E2',
              redBadge: '#FEF3F2',
              cardBg: '#F8F9FB',
              bodyBg: '#F4F7F9'
            }
          },
          boxShadow: {
            card: '0 20px 40px -15px rgba(0, 0, 0, 0.07), 0 0 1px 1px rgba(0, 0, 0, 0.03)'
          }
        }
      }
    };
  </script>
<!-- BEGIN: Custom Styles -->
<style data-purpose="custom-typography">
    @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap');
    body {
      font-family: 'Plus Jakarta Sans', sans-serif;
    }
  </style>
<!-- END: Custom Styles -->
</head>
<body class="bg-[#F6F8FA] min-h-screen text-slate-800 flex flex-col justify-between antialiased selection:bg-red-100 selection:text-red-700">
<!-- BEGIN: TopBar -->
<header class="w-full pt-6 px-8 sm:px-12 flex items-center justify-start" data-purpose="system-status-header">
<div class="flex items-center gap-2 text-[12px] font-medium text-slate-500">
<span class="inline-block w-2 h-2 rounded-full bg-emerald-500 ring-2 ring-emerald-100"></span>
<span>System Operational &amp; HIPAA Compliant</span>
</div>
</header>
<!-- END: TopBar -->
<!-- BEGIN: MainContent -->
<main class="flex-grow flex items-center justify-center px-4 py-8" data-purpose="auth-container">
<div class="w-full max-w-[430px] bg-white rounded-3xl p-8 sm:p-9 shadow-card border border-slate-100/80 flex flex-col items-center relative">
<!-- Top Red Link Icon Badge -->
<div class="w-12 h-12 rounded-2xl bg-red-50 text-red-500 flex items-center justify-center mb-5" data-purpose="icon-badge">
<svg class="w-5 h-5 -rotate-45" fill="none" stroke="currentColor" stroke-width="2" viewbox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
<path d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" stroke-linecap="round" stroke-linejoin="round"></path>
</svg>
</div>
<!-- Brand and Access Pill -->
<div class="flex items-center gap-1.5 mb-2.5" data-purpose="brand-heading">
<span class="text-[17px] font-bold text-slate-900 tracking-tight">MedTrack</span>
<span class="text-[10px] font-bold uppercase tracking-wider text-red-600 bg-red-50 border border-red-100 px-2 py-0.5 rounded-full">ACCESS</span>
</div>
<!-- Title and Subtitle -->
<h1 class="text-xl font-bold text-slate-900 text-center mb-2 tracking-tight">Reset your password</h1>
<p class="text-[13px] text-slate-500 text-center leading-relaxed max-w-[320px] mb-7">
        Enter the email address associated with your medication profile and we'll send a secure reset link.
      </p>
<!-- Form Section -->
<form class="w-full space-y-4" data-purpose="reset-password-form" onsubmit="event.preventDefault();">
<div>
<!-- Label & Required Tag -->
<div class="flex justify-between items-center mb-1.5">
<label class="text-xs font-semibold text-slate-800" for="email">Email Address</label>
<span class="text-[10px] font-bold text-red-600 uppercase tracking-wider">REQUIRED</span>
</div>
<!-- Input with leading icon -->
<div class="relative">
<div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
<svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewbox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
<path d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" stroke-linecap="round" stroke-linejoin="round"></path>
</svg>
</div>
<input class="w-full pl-10 pr-3.5 py-2.5 text-xs bg-slate-50 border border-slate-200/90 rounded-xl text-slate-800 placeholder-slate-400 focus:bg-white focus:outline-none focus:ring-2 focus:ring-red-500/20 focus:border-red-500 transition-all" id="email" name="email" placeholder="name@email.com" required="" type="email"/>
</div>
<!-- Alert Helper Note -->
<div class="flex items-start gap-1.5 mt-2 text-slate-500">
<svg class="h-3.5 w-3.5 text-red-500 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" stroke-width="2" viewbox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
<path d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" stroke-linecap="round" stroke-linejoin="round"></path>
</svg>
<span class="text-[11px] leading-tight text-slate-500">Ensure this matches your medication alert address</span>
</div>
</div>
<!-- Submit Button -->
<button class="w-full bg-[#D92D20] hover:bg-[#B42318] active:scale-[0.99] text-white font-medium text-xs py-3 px-4 rounded-xl flex items-center justify-center gap-1.5 shadow-sm transition-all duration-150" data-purpose="submit-button" type="submit">
<span>Send Reset Link</span>
<svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewbox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
<path d="M14 5l7 7m0 0l-7 7m7-7H3" stroke-linecap="round" stroke-linejoin="round"></path>
</svg>
</button>
<!-- Security Note Callout -->
<div class="bg-[#FFF5F5] border border-red-100 rounded-xl p-3 flex items-start gap-2.5 mt-3" data-purpose="security-note">
<div class="text-red-500 flex-shrink-0 mt-0.5">
<svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewbox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
<path d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" stroke-linecap="round" stroke-linejoin="round"></path>
</svg>
</div>
<p class="text-[11px] leading-snug text-slate-600">
<strong class="font-semibold text-slate-800">Security note:</strong> Links expire in 15 minutes for your health data privacy.
          </p>
</div>
</form>
<!-- Back to Log in Link -->
<a class="inline-flex items-center gap-1.5 text-xs font-semibold text-slate-700 hover:text-slate-900 mt-6 transition-colors" data-purpose="back-link" href="#">
<svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2" viewbox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
<path d="M10 19l-7-7m0 0l7-7m-7 7h18" stroke-linecap="round" stroke-linejoin="round"></path>
</svg>
<span>Back to Log in</span>
</a>
<!-- Caregiver / Support Help -->
<div class="mt-4 text-[12px] text-slate-500" data-purpose="support-link">
        Having trouble? <a class="font-semibold text-red-600 hover:text-red-700 underline-offset-2 hover:underline" href="#">Contact Caregiver or Support</a>
</div>
</div>
</main>
<!-- END: MainContent -->
<!-- BEGIN: Footer -->
<footer class="w-full pb-6 px-4 flex flex-col items-center gap-2" data-purpose="page-footer">
<!-- Security & Legal Pill -->
<div class="inline-flex items-center flex-wrap justify-center gap-2 bg-white/80 border border-slate-200/60 rounded-full px-4 py-1.5 text-[11px] text-slate-500 shadow-xs backdrop-blur-xs">
<span class="inline-flex items-center gap-1.5 font-medium text-slate-600">
<svg class="h-3 w-3 text-red-500" fill="none" stroke="currentColor" stroke-width="2" viewbox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
<path d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" stroke-linecap="round" stroke-linejoin="round"></path>
</svg>
        End-to-End Encrypted Medication Profile
      </span>
<span class="text-slate-300">•</span>
<a class="hover:text-slate-700 transition-colors" href="#">Privacy Policy</a>
<span class="text-slate-300">•</span>
<a class="hover:text-slate-700 transition-colors" href="#">Terms of Care</a>
</div>
<!-- Copyright -->
<p class="text-[10px] text-slate-400 text-center tracking-tight">
      © 2025 MedTrack Healthcare Systems, Inc. All rights reserved.
    </p>
</footer>
<!-- END: Footer -->
</body></html>