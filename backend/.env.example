PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-host>/medtrack?retryWrites=true&w=majority
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# Set to production on live servers (also disables demo tokens)
NODE_ENV=development
# Set to 1 only when running behind a trusted reverse proxy (nginx, Render, etc.)
# TRUST_PROXY=1

# Frontend origin used for CORS and password-reset links
CLIENT_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Brevo transactional email (server-side only; never expose to the frontend)
BREVO_API_KEY=your_brevo_api_key
BREVO_SENDER_EMAIL=verified-sender@example.com
BREVO_SENDER_NAME=MedTrack

# Dose reminder emails (cron runs every minute)
# Set to 0 to disable sending without removing the cron job.
EMAIL_REMINDERS_ENABLED=1
# How late a dose may still trigger a reminder (must stay below the 60-min grace)
REMINDER_MAX_CATCHUP_MINUTES=15
# Total send attempts per dose before it is left as failed
REMINDER_MAX_ATTEMPTS=3
